+// LOHN DER PRAEPARATORINNEN (Weg B, ab quantenSPraepLohnAbUnix):
+//
+//   - Bestellen: der Ausgeber legt neben dem Pfand v x quantenSPraepLohn in
+//     den Pfandtopf (Lohn der Bestellung). Ohne Deckung fuer Pfand UND Lohn:
+//     abgewiesen. Wer Quantengeld will, bezahlt die Menschen, die es
+//     praeparieren -- nicht das Grundeinkommen, keine neue Geldmenge.
+//   - Ausgabe: je Geloster genau quantenSPraepLohn an das Konto, das in
+//     derselben Transaktion bestaetigt hat (quantenSAusgabeGegenLos prueft jede
+//     Unterschrift; ohne alle Bestaetigungen keine Ausgabe, also kein Lohn).
+//   - Frist nach dem Los (Abbruch): der Lohn geht trotzdem an die Gelosten --
+//     sie haben Zeit freigehalten, und Abbrechen und Neu-Bestellen (Befund
+//     B2b) wird um v x Lohn teurer. Frist OHNE Los auf der Kette: der Lohn geht
+//     wie das Pfand ans Grundeinkommen (niemand ist gelost; wer das Los aus der
+//     oeffentlichen drand-Runde selbst rechnet und abbricht, soll dabei nichts
+//     zurueckbekommen).
+//
+// GELD BLEIBT ERHALTEN: jede Buchung geht Wallet -> Pfandtopf -> Geloste
+// bzw. Grundeinkommen, Summe genau v x quantenSPraepLohn. Bestellungen von
+// vor dem Stichtag tragen keinen Lohn (Feld fehlt, Bytes wie bisher).
+//
+// SCHLAFEND bis zum Stichtag (MaxInt64). Einschalten: Stichtag setzen, mit
+// Deploy-Waechter wie bei den anderen Stichtagen, und App (Ausgeber zeigt die
+// Kosten, Praeparatorin den Lohn).
+var quantenSPraepLohnAbUnix int64 = 9223372036854775807
+
+// quantenSPraepLohnAbOverride: nur fuer Tests (0 = Stichtag oben).
+var quantenSPraepLohnAbOverride atomic.Int64
+
+func quantenSPraepLohnAktiv(t int64) bool {
+	ab := quantenSPraepLohnAbUnix
+	if v := quantenSPraepLohnAbOverride.Load(); v != 0 {
+		ab = v
+	}
+	return t >= ab
+}
+
+// quantenSBestellLohnFuer: Lohn einer Bestellung mit v Gelosten, 0 vor dem
+// Stichtag.
+func quantenSBestellLohnFuer(v int, zeit int64) int64 {
+	if !quantenSPraepLohnAktiv(zeit) {
+		return 0
+	}
+	return int64(v) * quantenSPraepLohn
+}
+
+// quantenSLohnWege: wohin der Lohn einer Bestellung geht, wenn sie endet.
+// Gelost (Los auf der Kette): je Geloster quantenSPraepLohn. Sonst alles ans
+// Grundeinkommen. Keine Wege bei Lohn 0.
+func quantenSLohnWege(b *quantenSBestellung) []quantenWWeg {
+	if b.Lohn <= 0 {
+		return nil
+	}
+	if b.Runde == 0 || len(b.Los) != b.V {
+		return []quantenWWeg{{quantenWPfandAddr, ubiPoolAddr, b.Lohn}}
+	}
+	wege := make([]quantenWWeg, 0, len(b.Los))
+	for _, konto := range b.Los {
+		wege = append(wege, quantenWWeg{quantenWPfandAddr, konto, quantenSPraepLohn})
+	}
+	return wege
+}
