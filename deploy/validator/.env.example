# Aequitas-Validator -- Konfiguration. Nach .env kopieren und ausfuellen.
#
# PFLICHT (3 Werte):
# Passwort der lokalen Datenbank. Frei waehlen, nirgends sonst benutzen.
POSTGRES_PASSWORD=bitte-ein-langes-zufaelliges-passwort

# Die oeffentliche Adresse DIESES Knotens, wie andere ihn erreichen:
# http://<oeffentliche-IP>:8080 -- oder https://<domain>, wenn ein Proxy
# davor steht. Ohne SELF_URL laeuft der Knoten nur mit, meldet sich aber
# nirgends an (kein Validator, nur Beobachter).
SELF_URL=http://1.2.3.4:8080

# Dein eigenes Wallet -- MUSS ein registrierter Mensch sein (Registrierung
# in der App abgeschlossen). Ein Mensch = ein Validator. Ohne registrierten
# Menschen lehnt das Netz die Anmeldung ab.
NODE_OPERATOR_WALLET=0x...

# EMPFOHLEN:
# Der Schluessel, mit dem dieser Knoten Bloecke signiert (0x..., 66 Zeichen).
# Am einfachsten: der private Schluessel von NODE_OPERATOR_WALLET -- dann
# ist keine weitere Bindung noetig. Leer lassen = der Knoten erzeugt beim
# ersten Start einen und druckt ihn ins Log ("SAVE THIS AS ..."); den dann
# hier eintragen, sonst wechselt die Identitaet bei jedem Neustart.
RELAYER_PRIVATE_KEY=

# Wenn RELAYER_PRIVATE_KEY NICHT der Schluessel von NODE_OPERATOR_WALLET ist:
# auf https://aequitas.digital/node-binding die Nachricht mit dem Wallet
# signieren und die Signatur hier eintragen.
NODE_OPERATOR_BINDING_SIGNATURE=

# P2P-Identitaet. Leer lassen = wird beim ersten Start erzeugt und ins Log
# gedruckt; dann hier eintragen.
NODE_KEY=

# NICHT AENDERN, ausser du weisst warum:
# Die Knoten, bei denen sich dieser anmeldet und von denen er beim ersten
# Start den Zustand (Snapshot) bezieht. Signieradresse wird von dort geholt.
PRIMARY_NODE_URLS=http://173.249.37.118:8080,http://194.163.188.71:8080
PRIMARY_NODE_URL=http://173.249.37.118:8080

# Speicherdeckel des Knotens (Go). 5GiB wie auf den Gruenderboxen (12 GB RAM).
GOMEMLIMIT=5GiB
# Postgres-Puffer. Ein Viertel des RAM ist ein guter Wert.
POSTGRES_SHARED_BUFFERS=1GB
