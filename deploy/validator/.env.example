# Aequitas-Validator -- Konfiguration. Nach .env kopieren und ausfuellen.
#
# PFLICHT (3 Werte):
# Passwort der lokalen Datenbank. Frei waehlen, nirgends sonst benutzen.
POSTGRES_PASSWORD=bitte-ein-langes-zufaelliges-passwort

# Die oeffentliche Adresse DIESES Knotens, wie andere ihn erreichen:
# http://<oeffentliche-IP>:8080 -- oder https://<domain>, wenn ein Proxy
# davor steht. Ohne SELF_URL laeuft der Knoten nur mit, meldet sich aber
# nirgends an (kein Validator, nur Beobachter).
# Nur mit http://<oeffentliche-IP>:8080 stellen die anderen Validatoren die
# Anfragen, die dieser Knoten an sie weiterleitet, von ihrer Grenze je IP
# frei. Ein Name, eine private oder eine Tailscale-Adresse wird dort nicht
# freigestellt (ausser der andere Knoten nennt das Netz ausdruecklich in
# AEQUITAS_FREILISTE_NETZE, etwa 100.64.0.0/10 -- nie sein eigenes
# Docker-Netz; zu weite oder eigene Netze verwirft er selbst).
SELF_URL=http://1.2.3.4:8080

# Dein eigenes Wallet -- MUSS ein registrierter Mensch sein (Registrierung
# in der App abgeschlossen). Ein Mensch = ein Validator. Ohne registrierten
# Menschen lehnt das Netz die Anmeldung ab.
NODE_OPERATOR_WALLET=0x...

# Der EIGENE Schluessel dieses Knotens, mit dem er Bloecke signiert (0x...,
# 66 Zeichen). Leer lassen: der Knoten erzeugt beim ersten Start einen und
# druckt ihn einmal ins Log; einrichten.sh traegt ihn dann hier ein.
# NIE den privaten Schluessel deiner Wallet hier eintragen -- wer den Server
# knackt, haette sonst auch dein Guthaben.
RELAYER_PRIVATE_KEY=

# Normalerweise LEER lassen. Gebunden wird ueber die Seite deines eigenen
# Knotens: http://<IP>:8080/node-binding -- mit der Wallet unterschreiben,
# der Knoten traegt sich selbst ein. Nur wer ohne Browser-Wallet bindet,
# traegt hier die Signatur von "Aequitas: authorize validator <Signieradresse>" ein.
NODE_OPERATOR_BINDING_SIGNATURE=

# P2P-Identitaet. Leer lassen = wird beim ersten Start erzeugt und ins Log
# gedruckt; dann hier eintragen.
NODE_KEY=

# NICHT AENDERN, ausser du weisst warum:
# Nur EIN Knoten des Netzes nimmt Ueberweisungen an (heute C1). Ohne diese
# Zeile nimmt auch dieser Knoten an -- zwei Annehmende koennen die
# Kontostaende dauerhaft auseinanderlaufen lassen (annahme_tor.go).
# Blockproduktion, Belohnungen und Stimme als Validator betrifft das nicht.
ANNAHME_ROLLE=nur_lesend

# Die Knoten, bei denen sich dieser anmeldet und von denen er Bloecke holt.
# Seit dem Neustart bei null (30.09.2026) ist C1 der einzige Produzent.
PRIMARY_NODE_URLS=http://188.172.229.121:8080
PRIMARY_NODE_URL=http://188.172.229.121:8080

# Speicherdeckel des Knotens (Go). 5GiB wie auf den Gruenderboxen (12 GB RAM).
GOMEMLIMIT=5GiB
# Postgres-Puffer. Ein Viertel des RAM ist ein guter Wert.
POSTGRES_SHARED_BUFFERS=1GB
