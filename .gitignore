# Node modules
/node_modules

# Compilation output
/dist

# pnpm deploy output
/bundle

# Hardhat Build Artifacts
/artifacts

# Hardhat compilation (v2) support directory
/cache

# Typechain output
/types

# Environment files
.env

# Go build output — built by Dockerfile, never committed
/aequitasd
.env.*
!.env.example

# Hardhat coverage reports
/coverage

# Gas snapshot files
/.gas-snapshot

# Snapshot cheatcodes output
/snapshots

# Build artifacts and release binaries — use GitHub Releases instead
*.exe
*.apk
downloads/*.apk
build/msyh_extracted.ttf

# tools/contabo-loadtest generates disposable test-account private keys
# into this file — NEVER commit it, see gen_accounts.go's own comment.
/tools/contabo-loadtest/accounts.csv

# Credential material. The `.env` / `.env.*` rules above only match files whose
# name STARTS with ".env" — the operational files this project actually handles
# do not (`.aequitas.env`, `proof-server.env`, `*.env.bak-<ts>` produced by
# proof-server-install-autodeploy.yml). A copy pulled off a box for debugging
# would have been committable. Same for key material: nothing here matched
# *.pem / *.key / an SSH private key before.
*.env
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa*
id_ed25519
id_ed25519*

# Written by the deploy workflows on the validator box immediately before
# `docker build`, so the image can record which commit it was built from.
# It belongs to a checkout, never to the repository.
.git-commit-stamp

# Beaver multiplication triples produced by cmd/mpc-dealer.
#
# NEVER COMMIT THESE. Each file is one MPC party's secret correlated randomness.
# Anyone holding two parties' files for the same batch can reconstruct the
# triples, and a triple plus the traffic between the parties reconstructs the
# biometric templates that traffic was about. They are also single-use: a
# committed file would be restored and replayed, and a reused triple stops
# blinding and leaks the difference of the secrets it was used on.
mpc-triples/
*.bin
